# Magpi, local development.
#
# Everything here comes from `supabase start` and is public by construction.
# Real credentials are handed over by a person and live in web/.env.local, which is not
# committed. Values that supabase/config.toml reads through env() go in supabase/.env, which
# the CLI loads on its own.
#
# SB_ prefix on our own values: Supabase reserves SUPABASE_, and a secrets
# manager syncing into a project cannot write one.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SB_SERVICE_ROLE_KEY=

# Embeddings and chat. Required.
OPENAI_API_KEY=

# Account email. Magpi sends its own; the auth server sends none. See docs/email.md.
# Signs the send-email hook. Without it the hook refuses everything, so nothing is sent.
SB_AUTH_HOOK_SECRET=
# Deployed only. With no key, email goes to Mailpit instead, which is what local development wants.
RESEND_API_KEY=
SB_EMAIL_FROM=

# AES-256-GCM key for provider tokens at rest. 32 bytes, base64.
# Generate: openssl rand -base64 32
SB_TOKEN_ENC_KEY=
SB_TOKEN_ENC_KEY_ID=1

# OAuth apps. Optional until you connect a source.
#
# The variable name is derived from the provider slug in supabase/seed.sql:
# SB_<SLUG>_CLIENT_ID and SB_<SLUG>_CLIENT_SECRET, uppercased. Renaming a slug
# renames these, which is why Drive reads SB_GOOGLE_DRIVE_ rather than SB_GOOGLE_.
SB_NOTION_CLIENT_ID=
SB_NOTION_CLIENT_SECRET=
SB_LINEAR_CLIENT_ID=
SB_LINEAR_CLIENT_SECRET=
SB_SLACK_CLIENT_ID=
SB_SLACK_CLIENT_SECRET=
SB_GOOGLE_DRIVE_CLIENT_ID=
SB_GOOGLE_DRIVE_CLIENT_SECRET=

# Turns on the three quick-login buttons under the sign-in form, and nothing else.
# Off unless this is exactly "true". Never set it on a deployment that holds real content.
SB_DEMO_LOGIN=

# Social sign-in.
SB_GITHUB_CLIENT_ID=
SB_GITHUB_CLIENT_SECRET=

# Where the app and the functions live, so a callback knows where to come back
# to. SB_WEB_ORIGINS is comma separated and is the CORS allowlist.
SB_WEB_BASE_URL=http://localhost:3000
SB_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SB_FUNCTIONS_BASE_URL=http://127.0.0.1:55321/functions/v1

# Set only while rotating the token encryption key. Comma separated `id:key`
# entries, so tokens sealed under a retired key still open.
SB_TOKEN_ENC_KEYS_PREVIOUS=

# Billing. Optional until you touch the billing page.
SB_STRIPE_SECRET_KEY=
SB_STRIPE_WEBHOOK_SECRET=
SB_STRIPE_PRICE_TEAM=

# Deployed only. Pins the budget of a dream run started from the app, in milliseconds. The
# keynote sets 20000 so the run on stage times out inside the Edge Function on cue. Unset
# means the default 45 seconds. Compute runs have their own budget and ignore this.
SB_DREAM_RUN_BUDGET_MS=
